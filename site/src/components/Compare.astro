---
import { alternatives } from "../data/links";
---

<section class="section" id="compare">
  <div class="wrap">
    <div class="section__head reveal">
      <p class="eyebrow">Prior art</p>
      <h2>Others have built this. Here is where MixBar sits.</h2>
      <p class="lede">
        macOS has never shipped a per‑app volume mixer, so several people have written one
        for it. Worth knowing before you pick.
      </p>
    </div>

    <div class="compare">
      <ul class="others">
        {
          alternatives.map((other) => (
            <li class="card other reveal">
              <p class="other__kind">{other.kind}</p>
              <h3>
                <a href={other.href}>{other.name}</a>
              </h3>
              <p>{other.note}</p>
            </li>
          ))
        }
      </ul>

      <div class="card card--accent differently reveal">
        <h3>What MixBar does differently</h3>
        <ul>
          <li>
            <strong>Out of the path until a slider moves.</strong> No driver sits between your
            apps and your speakers at rest, and no tap exists for an app at 100%.
          </li>
          <li>
            <strong>A framework‑free core.</strong> The mixing rules import nothing and are
            covered by tests that need no audio hardware at all.
          </li>
          <li>
            <strong>Helpers grouped under their app.</strong> A browser cannot escape the mixer
            by moving audio to another helper process.
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .compare {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .others {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .other {
    padding: 22px 24px;
  }
  .other__kind {
    margin-bottom: 6px;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .other h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .other h3 a:hover {
    color: var(--brand-light);
  }
  .other p + p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }
  .differently {
    padding: 28px;
  }
  .differently ul {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 16px;
  }
  .differently li {
    padding-left: 18px;
    border-left: 2px solid var(--brand-indigo);
    color: var(--muted);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }
  .differently strong {
    display: block;
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 62rem) {
    .compare {
      grid-template-columns: 1fr;
    }
  }
</style>
