---
const steps = [
  {
    title: "List the audio processes.",
    body: "Every process holding an output stream open. That is the roster.",
  },
  {
    title: "Group them by app.",
    body: "Browsers and Electron apps play through helper processes. Each is folded under the app that owns it.",
  },
  {
    title: "Tap the apps you adjusted.",
    body: "One private tap per adjusted app. It silences the app's own output while MixBar reads it.",
  },
  {
    title: "Mix, and play it back.",
    body: "One aggregate device, one render callback: apply each gain, sum, write to your speakers.",
  },
];

const pipeline = ["Apps", "Process taps", "Aggregate device", "Render callback", "Your speakers"];
---

<section class="section how" id="how">
  <div class="wrap">
    <div class="section__head reveal">
      <p class="eyebrow">How it works</p>
      <h2>macOS has no per-app volume API. Here is the way around it.</h2>
      <p class="lede">
        Capture an app's audio and play it back at a different level. No kernel extension, no
        virtual driver.
      </p>
    </div>

    <ol class="pipeline reveal" aria-label="The audio path">
      {pipeline.map((stage) => <li>{stage}</li>)}
    </ol>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step card reveal">
            <span class="step__n grad">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

  </div>
</section>

<style>
  .pipeline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
    counter-reset: stage;
  }
  .pipeline li {
    padding: 10px 16px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--film);
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .pipeline li:first-child,
  .pipeline li:last-child {
    color: var(--muted);
    font-weight: 500;
  }
  .pipeline li + li::before {
    content: "→";
    margin-right: 12px;
    color: var(--brand-light);
  }
  /* The arrow has to sit outside the pill it belongs to. */
  .pipeline li + li {
    position: relative;
    margin-left: 22px;
  }
  .pipeline li + li::before {
    position: absolute;
    left: -24px;
    top: 50%;
    transform: translateY(-50%);
    margin: 0;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    padding: 24px;
  }
  .step__n {
    display: block;
    margin-bottom: 18px;
    font-family: var(--mono);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .step p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.9375rem;
    text-wrap: pretty;
  }

  @media (max-width: 62rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
