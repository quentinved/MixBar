---
import { Picture } from "astro:assets";
import { links } from "../data/links";
import { version } from "../data/repo";
import shot from "../assets/shots/comfortable-dark.png";
---

<header class="hero" id="top">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Free and open source · macOS 15 or later</p>
      <h1 class="hero__title">
        <span class="nowrap">Per-app</span> volume for Mac,<br />
        <span class="grad">in the menu bar.</span>
      </h1>
      <p class="hero__sub">
        A slider for every app that's making noise, a live meter inside each one, and your output
        device one click away. Nothing sits in your audio path until you move something.
      </p>
      <div class="cta">
        <a class="button button--primary" href={links.download}>Download for macOS</a>
        <a class="button" href={links.repo}>View the source</a>
      </div>
      <ul class="hero__facts">
        <li>Version {version}</li>
        <li>Apple silicon and Intel</li>
        <li>Signed and notarized</li>
        <li>MIT licence</li>
      </ul>
    </div>

    <!-- The real popover, captured at 2x by tools/screenshot.sh and declared at
         half size, so the app icons are the apps' own rather than stand-ins. -->
    <div class="hero__art">
      <div class="stage">
        <Picture
          class="stage__img"
          src={shot}
          formats={["avif", "webp"]}
          width={320}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          alt="The MixBar popover, open: a volume slider and live level meter for Arc, Discord, Microsoft Teams, Music, Spotify, VLC and Podcasts, with the output device named at the top."
        />
      </div>
    </div>
  </div>

  <a class="hero__more" href="#proof" aria-label="Read on">
    <span class="hero__chevron" aria-hidden="true"></span>
  </a>
</header>

<style>
  .hero {
    position: relative;
    display: grid;
    align-content: center;
    /* The fold is the hero and nothing else: a section peeking under it read
       as a layout accident rather than an invitation to scroll. */
    min-height: calc(100vh - var(--nav-h));
    min-height: calc(100svh - var(--nav-h));
    padding: 48px 0 24px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .hero__title {
    font-size: clamp(2.5rem, 5.6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
  }
  .hero__sub {
    margin-top: 22px;
    max-width: 32rem;
    color: var(--ink-2);
    font-size: 1.125rem;
    text-wrap: pretty;
  }
  .hero .cta {
    margin-top: 32px;
  }
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .hero__facts li + li::before {
    content: "·";
    margin: 0 10px;
    opacity: 0.6;
  }

  /* The stage is the frame the shot sits in: the tilt and the glow belong to
     the page, the pixels inside it belong to the app. */
  .hero__art {
    perspective: 1100px;
  }
  .stage {
    --tilt: rotateY(-9deg) rotateX(4deg);
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: center;
    padding: 44px 26px;
    border-radius: 28px;
    border: 1px solid var(--hairline);
    background: linear-gradient(
      135deg,
      rgba(107, 92, 242, 0.42),
      rgba(158, 61, 227, 0.26),
      rgba(107, 92, 242, 0.42)
    );
    background-size: 220% 220%;
    box-shadow:
      0 60px 130px -55px rgba(107, 92, 242, 0.85),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: var(--tilt);
  }
  .stage::after {
    content: "";
    position: absolute;
    inset: -40%;
    pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.16) 48%, transparent 56%);
    transform: translateX(-75%);
  }
  .stage__img {
    width: 320px;
    max-width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 34px 70px -24px rgba(5, 3, 12, 0.85);
  }

  .hero__more {
    justify-self: center;
    margin-top: 40px;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--film);
    color: var(--muted);
  }
  .hero__more:hover {
    color: var(--ink);
    border-color: rgba(167, 155, 247, 0.5);
  }
  .hero__chevron {
    width: 9px;
    height: 9px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes art-in {
    from {
      opacity: 0;
      transform: rotateY(-26deg) rotateX(12deg) translateY(34px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: var(--tilt);
    }
  }
  @keyframes sweep {
    0% {
      transform: translateX(-75%);
    }
    24%,
    100% {
      transform: translateX(75%);
    }
  }
  @keyframes drift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }
  @keyframes hero-exit {
    to {
      opacity: 0;
      transform: translateY(-36px) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * {
      animation: rise-in 0.7s var(--ease-out) backwards;
    }
    .hero__copy > :nth-child(1) { animation-delay: 0.05s; }
    .hero__copy > :nth-child(2) { animation-delay: 0.13s; }
    .hero__copy > :nth-child(3) { animation-delay: 0.21s; }
    .hero__copy > :nth-child(4) { animation-delay: 0.29s; }
    .hero__copy > :nth-child(5) { animation-delay: 0.37s; }
    .stage {
      animation:
        drift 22s ease-in-out infinite,
        art-in 1.1s var(--ease-out) 0.2s backwards;
    }
    .stage::after {
      animation: sweep 9s var(--ease-soft) 1.6s infinite;
    }
    .hero__more {
      animation:
        rise-in 0.7s var(--ease-out) 0.5s backwards,
        nudge 2.6s var(--ease-soft) 1.5s infinite;
    }
    @supports (animation-timeline: view()) {
      .hero__grid {
        animation: hero-exit linear both;
        animation-duration: auto;
        animation-timeline: view();
        animation-range: exit 0% exit 90%;
      }
    }
  }

  @media (max-width: 62rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 44px;
      max-width: var(--measure);
      text-align: center;
    }
    .hero__sub {
      margin-inline: auto;
    }
    .hero .cta,
    .hero__facts {
      justify-content: center;
    }
    /* Flat on a narrow screen: the tilt costs horizontal room there, not depth. */
    .stage {
      --tilt: none;
    }
  }
</style>
