---
import { links } from "../data/links";

const sections = [
  ["Try it", "/#demo"],
  ["Features", "/#features"],
  ["How it works", "/#how"],
  ["FAQ", "/#faq"],
] as const;
---

<nav class="nav" aria-label="Primary">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/">
      <img src="/mark.svg" width="26" height="26" alt="" />
      <span>MixBar</span>
    </a>
    <ul class="nav__links">
      {sections.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <a class="nav__github" href={links.repo} aria-label="MixBar on GitHub">
      <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
    <a class="button button--primary button--small" href={links.download}>Download</a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(12, 10, 20, 0.7);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    backdrop-filter: saturate(160%) blur(16px);
    border-bottom: 1px solid var(--hairline);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--nav-h);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-right: auto;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .nav__links {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .nav__links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav__links a:hover {
    color: var(--ink);
  }
  .nav__github {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .nav__github:hover {
    color: var(--ink);
  }

  @media (max-width: 62rem) {
    .nav__links {
      display: none;
    }
  }
</style>
