---
// A fixed roster, posed like the screenshots: a couple of apps turned down,
// one muted, one holding a stream open while playing nothing. Glyphs are
// inline SVG: the CSP's img-src 'self' blocks data: URIs, masks included.
const roster = [
  { name: "Music", volume: 78, color: "#f2515d", glyph: "M8 3v10.3A3 3 0 1 0 10 16V7l6-1.5V3z" },
  {
    name: "Browser",
    volume: 100,
    color: "#5b8def",
    glyph:
      "M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm5.9 7h-2.4a13 13 0 0 0-1.2-4.5A6.1 6.1 0 0 1 15.9 9zM10 4a11 11 0 0 1 1.5 5h-3A11 11 0 0 1 10 4zM4.1 11h2.4a13 13 0 0 0 1.2 4.5A6.1 6.1 0 0 1 4.1 11zm2.4-2H4.1a6.1 6.1 0 0 1 3.6-4.5A13 13 0 0 0 6.5 9zM10 16a11 11 0 0 1-1.5-5h3A11 11 0 0 1 10 16zm2.3-.5a13 13 0 0 0 1.2-4.5h2.4a6.1 6.1 0 0 1-3.6 4.5z",
  },
  {
    name: "Video call",
    volume: 34,
    color: "#35b37c",
    glyph:
      "M6.6 2.5 8.4 6 6.9 7.6a9 9 0 0 0 5.5 5.5L14 11.6l3.5 1.8-.6 3a1.6 1.6 0 0 1-1.7 1.3A13 13 0 0 1 2.3 4.8 1.6 1.6 0 0 1 3.6 3.1z",
  },
  {
    name: "Podcasts",
    volume: 0,
    color: "#8f4de0",
    glyph:
      "M10 2a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3zm-6 8h2a4 4 0 0 0 8 0h2a6 6 0 0 1-5 5.9V18H9v-2.1A6 6 0 0 1 4 10z",
  },
  {
    name: "Game",
    volume: 100,
    color: "#e08c2b",
    silent: true,
    glyph:
      "M6 5h8a5 5 0 0 1 5 5v1a3 3 0 0 1-5.3 1.9L12.5 11h-5l-1.2 1.9A3 3 0 0 1 1 11v-1a5 5 0 0 1 5-5zm1 2v1.5H5.5v1.5H7V11.5h1.5V10H10V8.5H8.5V7zm6 .5a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm-2 2a1 1 0 1 0 0 2 1 1 0 0 0 0-2z",
  },
];
---

<section class="section demo" id="demo">
  <div class="wrap">
    <div class="section__head section__head--center reveal">
      <p class="eyebrow">Try it</p>
      <h2>The popover, rebuilt in the page.</h2>
      <p class="lede">
        Drag a slider. The bright band is the live meter, measured after your gain. The line at
        the bottom is what MixBar has actually put in your audio path.
      </p>
    </div>

    <div class="demo__stage reveal">
      <div class="popover" data-demo>
        <div class="popover__bar">
          <span class="popover__title">MixBar</span>
          <span class="popover__layouts" aria-hidden="true">
            <i>
              <svg viewBox="0 0 16 16"><path d="M5 4h8M5 8h8M5 12h8" /><path class="dot" d="M2.5 4h.01M2.5 8h.01M2.5 12h.01" /></svg>
            </i>
            <i class="is-on">
              <svg viewBox="0 0 16 16"><rect x="2.5" y="3" width="11" height="4" rx="1.2" /><rect x="2.5" y="9" width="11" height="4" rx="1.2" /></svg>
            </i>
            <i>
              <svg viewBox="0 0 16 16"><path d="M4 2.5v11M8 2.5v11M12 2.5v11M2.5 10h3M6.5 5h3M10.5 8h3" /></svg>
            </i>
          </span>
          <span class="popover__dots" aria-hidden="true">···</span>
        </div>
        <p class="popover__device">
          <svg width="14" height="18" viewBox="0 0 14 18" aria-hidden="true">
            <rect x="1" y="1" width="12" height="16" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
            <circle cx="7" cy="5.5" r="1.4" fill="currentColor"></circle>
            <circle cx="7" cy="11.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          </svg>
          MacBook Pro Speakers
        </p>

        <ul class="popover__rows">
          {
            roster.map((app) => (
              <li
                class="row"
                data-channel={app.name}
                data-silent={app.silent ? "" : undefined}
                data-volume={app.volume}
              >
                <span class={`tile tile--${app.name.toLowerCase().replace(" ", "-")}`} aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="20" height="20">
                    <path d={app.glyph} />
                  </svg>
                </span>
                <span class="row__name">
                  {app.name}
                  <span class="row__tag">routed</span>
                </span>
                <span class="row__percent" data-percent>
                  {app.volume}%
                </span>
                <button
                  class="row__mute"
                  type="button"
                  data-mute
                  aria-label={`Mute ${app.name}`}
                  aria-pressed={app.volume === 0 ? "true" : "false"}
                >
                  <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
                    <path d="M3 7h3l4-3v10l-4-3H3z" fill="currentColor" />
                    <path class="wave" d="M12.5 6.5a3.5 3.5 0 0 1 0 5M14.5 4.5a6 6 0 0 1 0 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path class="cross" d="M12 7l4 4M16 7l-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </button>
                <span class="fader">
                  <span class="fader__bar fader__bar--track" />
                  <span class="fader__bar fader__bar--fill" />
                  <span class="fader__bar fader__bar--meter" />
                  <span class="fader__thumb" />
                  <input type="range" min="0" max="100" value={app.volume} aria-label={`${app.name} volume`} />
                </span>
              </li>
            ))
          }
        </ul>

        <div class="popover__foot">
          <p class="popover__status" data-status aria-live="polite">
            <span data-status-head>Audio path untouched</span>
            <span class="popover__detail" data-status-detail>No taps, no aggregate device.</span>
          </p>
          <button class="popover__reset" type="button" data-reset>Reset all</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .demo__stage {
    display: flex;
    justify-content: center;
    padding: 40px 16px;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60% 80% at 50% 50%, rgba(107, 92, 242, 0.22), transparent 70%),
      var(--film);
    border: 1px solid var(--hairline);
  }
  .popover {
    width: 100%;
    max-width: 380px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #1c1a24;
    box-shadow:
      0 40px 80px -30px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    font-size: 0.9375rem;
  }
  .popover__bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px 6px;
  }
  .popover__title {
    margin-right: auto;
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .popover__layouts {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.07);
  }
  .popover__layouts i {
    display: grid;
    place-items: center;
    width: 26px;
    height: 20px;
    border-radius: 6px;
    color: var(--muted);
  }
  .popover__layouts .is-on {
    background: var(--brand);
    color: #fff;
  }
  .popover__layouts svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .popover__layouts .dot {
    stroke-width: 2.2;
  }
  .popover__dots {
    letter-spacing: 1px;
    font-weight: 700;
    color: var(--muted);
  }
  .popover__device {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 16px 12px;
    border-bottom: 1px solid var(--hairline);
    font-weight: 600;
  }
  .popover__rows {
    margin: 0;
    padding: 8px 6px;
    list-style: none;
  }

  /* --gain and --level are the only things the script writes. Their resting
     values below are what someone without JavaScript sees. */
  .row {
    --gain: 1;
    --level: 0.55;
    display: grid;
    grid-template-columns: 40px 1fr auto 28px;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 12px;
    padding: 8px 10px;
    border-radius: 12px;
  }
  .row:nth-child(1) { --gain: 0.78; --level: 0.5; }
  .row:nth-child(3) { --gain: 0.34; --level: 0.2; }
  .row:nth-child(4) { --gain: 0; --level: 0; }
  .row:nth-child(5) { --level: 0; }

  .tile {
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--tile) linear-gradient(180deg, rgba(255, 255, 255, 0.28), transparent);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .tile svg {
    fill: currentColor;
  }
  .tile--music { --tile: #f2515d; }
  .tile--browser { --tile: #5b8def; }
  .tile--video-call { --tile: #35b37c; }
  .tile--podcasts { --tile: #8f4de0; }
  .tile--game { --tile: #e08c2b; }
  .row[data-muted] .tile,
  [data-silent] .tile {
    opacity: 0.55;
  }

  .row__name {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-weight: 600;
    color: var(--ink);
  }
  .row[data-muted] .row__name,
  [data-silent] .row__name {
    color: var(--muted);
  }
  .row__tag {
    display: none;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-light);
  }
  [data-live] .row[data-routed] .row__tag {
    display: inline;
  }
  .row__percent {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--ink-2);
  }
  .row__mute {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--brand-light);
    cursor: pointer;
  }
  .row__mute:hover {
    background: rgba(255, 255, 255, 0.07);
  }
  .row__mute .cross,
  .row[data-muted] .row__mute .wave {
    display: none;
  }
  .row[data-muted] .row__mute {
    color: var(--muted);
  }
  .row[data-muted] .row__mute .cross {
    display: block;
  }

  /* A native range, invisible, on top of the drawn track: the keyboard and
     the screen reader get the real control, the eye gets the app's. */
  .fader {
    grid-column: 2 / -1;
    position: relative;
    height: 22px;
    margin-top: 2px;
  }
  .fader__bar,
  .fader__thumb {
    position: absolute;
    top: 50%;
    pointer-events: none;
  }
  .fader__bar {
    left: 0;
    height: 6px;
    border-radius: 3px;
    transform: translateY(-50%);
  }
  .fader__bar--track {
    width: 100%;
    background: rgba(255, 255, 255, 0.1);
  }
  .fader__bar--fill {
    width: calc(var(--gain) * 100%);
    background: linear-gradient(90deg, var(--brand-indigo), var(--brand-violet));
  }
  .fader__bar--meter {
    width: calc(var(--level) * 100%);
    background: rgba(255, 255, 255, 0.55);
    mix-blend-mode: screen;
  }
  .fader__thumb {
    left: calc(var(--gain) * 100%);
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    transform: translate(-50%, -50%);
  }
  .row[data-muted] .fader__thumb,
  [data-silent] .fader__thumb {
    background: #8d8a98;
  }
  [data-silent] .fader__bar--fill {
    opacity: 0.55;
  }
  .fader input {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .fader:has(input:focus-visible) .fader__thumb {
    outline: 2px solid var(--brand-indigo);
    outline-offset: 3px;
  }

  .popover__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px 14px;
    border-top: 1px solid var(--hairline);
  }
  .popover__status {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    line-height: 1.4;
    font-weight: 600;
  }
  .popover__detail {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--muted);
  }
  .popover__reset {
    flex-shrink: 0;
    padding: 6px 12px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--film);
    color: var(--ink);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .popover__reset:hover {
    border-color: rgba(167, 155, 247, 0.5);
  }
</style>

<script src="../scripts/demo.ts"></script>
