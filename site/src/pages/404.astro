---
import Base from "../layouts/Base.astro";
import { links } from "../data/links";
---

<Base title="Page not found — MixBar" description="That page does not exist. MixBar is one page and one download." noindex>
  <main class="lost">
    <div class="wrap lost__inner">
      <img src="/mark.svg" width="96" height="96" alt="" />
      <h1 class="grad">404</h1>
      <p class="lede">That page does not exist. MixBar itself is one page and one download, both below.</p>
      <div class="cta">
        <a class="button button--primary" href="/">Back to MixBar</a>
        <a class="button" href={links.repo}>View the source</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .lost {
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--nav-h));
    padding: 48px 0;
    text-align: center;
  }
  .lost__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: var(--measure);
  }
  h1 {
    margin-top: 24px;
    font-size: clamp(4rem, 14vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .lost .cta {
    justify-content: center;
    margin-top: 32px;
  }
</style>
