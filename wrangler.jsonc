// Workers Builds runs `wrangler versions upload` from the repository root with
// no arguments, so without this file the deploy fails with "Missing entry-point
// to Worker script or to assets directory".
{
  // Must match the Worker in the Cloudflare dashboard, or the upload silently
  // lands on a second Worker that no custom domain points at.
  "name": "mixbar",
  "compatibility_date": "2026-09-18",
  // The page is static files, so there is no script: the assets are the Worker.
  // _headers and _redirects live inside this directory and are applied from it.
  "assets": {
    "directory": "./site",
    // Default is a bare 404 body, which reads to a crawler as a soft 404 on
    // every mistyped URL. This serves site/404.html with the 404 status intact.
    "not_found_handling": "404-page"
  }
}
